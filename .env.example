# Local disposable PostgreSQL only. Replace for your own development database.
POSTGRES_DB=phantoms
POSTGRES_USER=phantoms
POSTGRES_PASSWORD=dev-only-change-me
DATABASE_URL=postgres://phantoms:dev-only-change-me@127.0.0.1:5432/phantoms

# The API binds to loopback by default. Use 0.0.0.0 only inside a container
# behind a trusted ingress, with authentication and network policy configured.
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
API_BEARER_TOKEN=

# Logging: one JSON object per line on stdout. One of debug, info, warn, error.
LOG_LEVEL=info

# Optional OpenTelemetry trace export over OTLP/HTTP. Tracing is OFF unless
# OTEL_EXPORTER_OTLP_ENDPOINT is set, and then spans go to that collector's
# /v1/traces. Put authentication in OTEL_EXPORTER_OTLP_HEADERS on the server;
# never commit a real endpoint or header value.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SERVICE_NAME=phantoms-api

# Optional server-side AI provider implementing the OpenAI-compatible API.
# Keep these values on the server; never prefix secrets with NEXT_PUBLIC_.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
