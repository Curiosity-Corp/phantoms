# Local disposable PostgreSQL only. Replace for your own development database.
POSTGRES_DB=phantoms
POSTGRES_USER=phantoms
POSTGRES_PASSWORD=dev-only-change-me
DATABASE_URL=postgres://phantoms:dev-only-change-me@127.0.0.1:5432/phantoms

# The API binds to loopback by default. Use 0.0.0.0 only inside a container
# behind a trusted ingress, with authentication and network policy configured.
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
API_BEARER_TOKEN=

# Optional server-side AI provider implementing the OpenAI-compatible API.
# Keep these values on the server; never prefix secrets with NEXT_PUBLIC_.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional Compose profiles (docs/retrieval.md). Off unless you start them with
# `docker compose --profile pgvector|objects|retrieval up -d`. These are
# disposable local values for loopback-only services; never reuse them.
# PGVECTOR_DATABASE_URL turns on the pgvector tests, so leave it commented
# unless that profile is running (Bun loads .env automatically).
# COMPOSE_PROJECT_NAME=phantoms
# PGVECTOR_DATABASE_URL=postgres://phantoms:dev-only-change-me@127.0.0.1:5433/phantoms
S3_ACCESS_KEY=phantoms-local
S3_SECRET_KEY=phantoms-local-secret
