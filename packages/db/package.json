{
  "name": "@phantoms/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "typecheck": "bun run --bun tsc --noEmit",
    "db:generate": "bun run --bun drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "bun run --bun drizzle-kit migrate --config drizzle.config.ts",
    "db:check": "bun run --bun drizzle-kit check --config drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "postgres": "4.0.0"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2"
  }
}
