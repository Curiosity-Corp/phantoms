    "typecheck": "bun run --bun tsc --noEmit"
  },
  "dependencies": {
    "@hono/bun": "1.0.0",
    "@phantoms/db": "workspace:*",
    "hono": "4.13.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
