{
  "name": "@phantoms/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --bun --watch src/server.ts",
    "build": "bun build src/server.ts --target=bun --outdir=dist",
    "start": "bun run dist/server.js",
    "typecheck": "bun run --bun tsc --noEmit"
  },
  "dependencies": {
    "@hono/bun": "1.0.0",
    "@hono/otel": "1.2.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace": "2.12.0",
    "@phantoms/db": "workspace:*",
    "hono": "4.13.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
