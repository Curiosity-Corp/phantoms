{
  "name": "phantoms-starter",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --bun turbo run dev --parallel",
    "build": "bun run --bun turbo run build",
    "lint": "bun run --bun biome check .",
    "typecheck": "bun run --bun turbo run typecheck",
    "test": "bun test",
    "db:generate": "bun run --filter @phantoms/db db:generate",
    "db:migrate": "bun run --filter @phantoms/db db:migrate",
    "db:check": "bun run --filter @phantoms/db db:check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "turbo": "2.11.6",
    "typescript": "7.0.2"
  }
}
